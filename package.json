{
  "name": "@tazeai/repo",
  "private": true,
  "description": "TazeAI Monorepo",
  "homepage": "https://tazeai.com",
  "bugs": {
    "url": "https://github.com/tazeai/tazeai/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tazeai/tazeai"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "lorenx@163.com"
  },
  "scripts": {
    "build": "turbo build --filter=\"./packages/**\"",
    "bump-ui": "pnpx shadcn@canary add --all --overwrite -c packages/ui && pnpm format",
    "clean": "turbo run clean --parallel",
    "coverage": "vitest --coverage",
    "dev": "NODE_ENV=development turbo dev --parallel",
    "format": "biome format --write ./",
    "lint": "biome check --write ./",
    "prepare": "husky",
    "start": "turbo run start --filter=\"./apps/*\"",
    "test": "turbo test --cache-dir=.turbo",
    "update:deps": "pnpm update --recursive --interactive --latest",
    "dedupe": "pnpm dedupe",
    "audit": "pnpm audit --audit-level moderate",
    "audit:fix": "pnpm audit --fix",
    "deps:check": "pnpm outdated --recursive",
    "deps:analyze": "pnpm list --depth=0 --long",
    "security:check": "pnpm audit && pnpm dedupe --check",
    "typecheck": "turbo typecheck",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "pnpm format"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@tazeai/vitest": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "^8.0.0",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.4",
    "type-fest": "^4.41.0",
    "typescript": "^5.8.3",
    "vite": "catalog:",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "^20 || >=22",
    "pnpm": ">=9.10.0"
  }
}
