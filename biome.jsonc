{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "assists": {
    "actions": {
      "source": {
        "sortJsxProps": "on",
        "useSortedKeys": "on"
      }
    },
    "enabled": true
  },
  "extends": ["ultracite"],
  "files": {
    "ignore": [
      "**/.turbo",
      "**/coverage",
      "**/dist",
      "**/pnpm-lock.yaml",
      "**/CHANGELOG.md",
      "**/package.json"
    ]
  },
  "formatter": {
    "attributePosition": "auto",
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "all": false
      },
      "complexity": {
        "all": false
      },
      "correctness": {
        "noUndeclaredVariables": "off",
        "noUnusedFunctionParameters": "off",
        "noUnusedVariables": "off",
        "useExhaustiveDependencies": "off"
      },
      "nursery": {
        "all": false
      },
      "performance": {
        "all": false
      },
      "security": {
        "all": false
      },
      "style": {
        "all": false
      },
      "suspicious": {
        "all": false
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
