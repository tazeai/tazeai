{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/*", ".next/*"]
    },
    "clean": {
      "cache": false,
      "outputLogs": "none"
    },
    "dev": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "persistent": true
    },
    "generate": {
      "cache": false,
      "outputLogs": "none"
    },
    "start": {
      "cache": false,
      "dependsOn": ["^start"]
    }
  },
  "ui": "stream"
}
