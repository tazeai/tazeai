{
  "name": "@tazeai/email",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./envs": {
      "import": {
        "types": "./dist/envs.d.ts",
        "default": "./dist/envs.mjs"
      },
      "require": {
        "types": "./dist/envs.d.cts",
        "default": "./dist/envs.cjs"
      }
    },
    "./templates/*": "./src/templates/*.tsx"
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build": "unbuild",
    "dev": "unbuild --watch"
  },
  "dependencies": {
    "@react-email/components": "^0.1.1",
    "@react-email/render": "^1.1.3",
    "@tazeai/env": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.6.0"
  },
  "devDependencies": {
    "@tazeai/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3",
    "unbuild": "^3.5.0"
  }
}
