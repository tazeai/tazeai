{
  "name": "@tazeai/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./envs": {
      "import": {
        "types": "./dist/envs.d.ts",
        "default": "./dist/envs.mjs"
      },
      "require": {
        "types": "./dist/envs.d.cts",
        "default": "./dist/envs.cjs"
      }
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --watch",
    "clean": "rimraf dist .turbo",
    "test": "vitest",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tazeai/env": "workspace:*"
  },
  "devDependencies": {
    "@tazeai/typescript": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "^5.8.3",
    "unbuild": "^3.5.0"
  }
}
