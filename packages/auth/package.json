{
  "name": "@tazeai/auth",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./envs": {
      "import": {
        "types": "./dist/envs.d.ts",
        "default": "./dist/envs.mjs"
      },
      "require": {
        "types": "./dist/envs.d.cts",
        "default": "./dist/envs.cjs"
      }
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware.d.ts",
        "default": "./dist/middleware.mjs"
      },
      "require": {
        "types": "./dist/middleware.d.cts",
        "default": "./dist/middleware.cjs"
      }
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --watch",
    "clean": "rimraf dist .turbo",
    "generate": "pnpm with-env pnpx @better-auth/cli generate --config=src/auth.ts",
    "test": "vitest",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@iconify/react": "^6.0.0",
    "@tazeai/cache": "workspace:*",
    "@tazeai/db": "workspace:*",
    "@tazeai/email": "workspace:*",
    "@tazeai/env": "workspace:*",
    "bcrypt-ts": "^7.1.0",
    "better-auth": "^1.2.12",
    "lodash-es": "^4.17.21",
    "react-hook-form": "^7.59.0",
    "react-i18next": "^15.6.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.6",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tazeai/typescript": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "catalog:",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3",
    "unbuild": "^3.5.0",
    "vitest": "^3.2.4"
  }
}
