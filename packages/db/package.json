{
  "name": "@tazeai/db",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./envs": {
      "import": {
        "types": "./dist/envs.d.ts",
        "default": "./dist/envs.mjs"
      },
      "require": {
        "types": "./dist/envs.d.cts",
        "default": "./dist/envs.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.mjs"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query/index.d.ts",
        "default": "./dist/query/index.mjs"
      },
      "require": {
        "types": "./dist/query/index.d.cts",
        "default": "./dist/query/index.cjs"
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build": "unbuild",
    "dev": "unbuild --watch",
    "generate": "pnpm with-env drizzle-kit generate",
    "migrate": "pnpm with-env drizzle-kit migrate",
    "push": "pnpm with-env drizzle-kit push",
    "seed": "pnpm with-env tsx seed.ts",
    "studio": "pnpm with-env drizzle-kit studio",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@tazeai/env": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.2",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.1.5",
    "postgres": "^3.4.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tazeai/typescript": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "unbuild": "^3.5.0"
  }
}
